# SQLite database file (relative to prisma/ folder)
DATABASE_URL="file:./dev.db"

# Secret used to sign admin session cookies — keep private
AUTH_SECRET="replace-with-a-long-random-string"

# First admin account (created by the seed script if no user exists).
# Lost the password on a server? Set ADMIN_FORCE_PASSWORD="true" here, restart the app once (it resets this
# account to ADMIN_PASSWORD, creating it if needed), then remove the flag.
ADMIN_EMAIL="admin@capetown-kw.com"
ADMIN_PASSWORD="ChangeMe123!"

# Public URL of the site (used for QR codes, sitemap, OpenGraph)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Default language for URLs without a prefix (ar = Arabic, en = English)
NEXT_PUBLIC_DEFAULT_LOCALE="en"

# Where uploaded media is stored (absolute or relative to project root)
UPLOAD_DIR="./storage/uploads"
