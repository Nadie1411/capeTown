  "private": true,
  "description": "Cape Town General Trading & Contracting Co. W.L.L \u2014 bilingual website with a full admin panel / page builder",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "setup": "prisma generate && prisma db push && tsx prisma/seed.ts",
    "placeholders": "node scripts/make-placeholders.mjs",
    "backup": "node scripts/backup.mjs",
    "reset-password": "tsx scripts/reset-password.ts",
    "photos": "node scripts/fetch-photos.mjs"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
