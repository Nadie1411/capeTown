# ---- Cape Town website — production settings (copy to .env on the server) ----

# SQLite database file (relative to the prisma/ folder). Keep it outside public web access.
DATABASE_URL="file:./prod.db"

# Long random secret used to sign admin sessions — generate a new one for every server
AUTH_SECRET="replace-with-64-random-characters"

# First admin account (created by the setup script if no user exists yet).
# To reset a lost password later: add ADMIN_FORCE_PASSWORD="true", restart the app once, then remove the flag.
ADMIN_EMAIL="admin@capetown-kw.com"
ADMIN_PASSWORD="ChangeMe123!"

# Public URL of the site, INCLUDING the sub-folder if the site lives in one
NEXT_PUBLIC_SITE_URL="https://albahloul.com/elegant/test"

# Sub-folder the site is served from ("" for the domain root). Must match the value used at build time.
NEXT_PUBLIC_BASE_PATH="/elegant/test"

# Default language served at the root ("en" or "ar")
NEXT_PUBLIC_DEFAULT_LOCALE="en"

# Uploaded media folder (relative to the app root)
UPLOAD_DIR="./storage/uploads"
